{
  "name": "@seaveyon/harness-switch",
  "version": "0.16.1",
  "description": "A secure web control plane that switches API providers for Claude Code, Codex, Kimi Code, Pi and DeepSeek Harness by writing their native config files on SSH servers.",
  "keywords": [
    "claude-code",
    "codex",
    "kimi-code",
    "pi",
    "pi-coding-agent",
    "deepseek-harness",
    "api-key",
    "ssh",
    "headless"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/B1anker/harness-switch.git"
  },
  "type": "module",
  "bin": {
    "harness-switch": "./dist/harness-switch.js"
  },
  "files": [
    "dist/",
    "public/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "HSW_UPDATE_CHECK=0 bun --hot src/main.ts server",
    "start": "bun dist/harness-switch.js",
    "start:foreground": "bun dist/harness-switch.js server",
    "build": "bun build src/main.ts --outfile dist/harness-switch.js --target bun && bun ../../scripts/postbuild.ts",
    "test": "bun test test"
  },
  "dependencies": {
    "@seaveyon/harness-switch-shared": "workspace:*",
    "hono": "^4.10.3",
    "smol-toml": "^1.8.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
